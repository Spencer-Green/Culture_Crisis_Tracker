{
  "name": "culture-crisis-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "abs:inspect": "tsx scripts/abs-inspect.ts",
    "ingest:abs": "node --conditions=react-server --import tsx scripts/ingest-abs.ts",
    "ons:inspect": "tsx scripts/ons-inspect.ts",
    "ingest:ons": "node --conditions=react-server --import tsx scripts/ingest-ons.ts",
    "bea:inspect": "tsx scripts/bea-inspect.ts",
    "ingest:bea": "node --conditions=react-server --import tsx scripts/ingest-bea.ts",
    "fred:inspect": "tsx scripts/fred-inspect.ts",
    "ingest:fred": "node --conditions=react-server --import tsx scripts/ingest-fred.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
