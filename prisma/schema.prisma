generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(3)
  name               String              @unique
  region             String
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  dataSources        DataSource[]
  metricDefinitions  MetricDefinition[]
  industryEvents     IndustryEvent[]
  mediaArticles      MediaArticle[]
  ticketmasterEvents TicketmasterEvent[]
  ticketmasterVenues TicketmasterVenue[]
}

model Sector {
  id                 String              @id @default(uuid()) @db.Uuid
  slug               String              @unique
  name               String              @unique
  description        String
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  dataSources        DataSource[]
  metricDefinitions  MetricDefinition[]
  industryEvents     IndustryEvent[]
  mediaArticles      MediaArticle[]
  ticketmasterEvents TicketmasterEvent[]
}

model DataSource {
  id                     String                    @id @default(uuid()) @db.Uuid
  slug                   String                    @unique
  name                   String
  provider               String
  baseUrl                String
  countryCode            String?                   @db.VarChar(3)
  sectorSlug             String?
  requiresAuthentication Boolean                   @default(false)
  enabled                Boolean                   @default(false)
  lastSuccessfulSyncAt   DateTime?                 @db.Timestamptz(3)
  lastAttemptedSyncAt    DateTime?                 @db.Timestamptz(3)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(3)
  country                Country?                  @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector                 Sector?                   @relation(fields: [sectorSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  metricDefinitions      MetricDefinition[]
  ingestionRuns          IngestionRun[]
  ticketmasterEvents     TicketmasterEvent[]
  games                  Game[]
  steamGameSnapshots     SteamGameSnapshot[]
  mediaArticles          MediaArticle[]
  mediaArticleMatches    MediaArticleSourceMatch[]
  usBoxOfficeWeekends    USBoxOfficeWeekend[]
  broadwayMarketWeeks    BroadwayMarketWeek[]
  lpaPerformanceYears    LPAPerformanceMarketYear[]
  bfiWeekendBoxOffice    BFIWeekendBoxOffice[]
  bfiFilmMarketYears     BFIFilmMarketYear[]
  mvtGrassrootsYears     MVTGrassrootsMusicYear[]
  censusRecordYears      CensusRecordIndustryYear[]
  beaAcpsaSoundYears     BEAACPSASoundRecordingYear[]
  schedulerState         SchedulerSourceState?

  @@index([countryCode])
  @@index([sectorSlug])
  @@index([enabled])
}

model SchedulerSourceState {
  id                  String     @id @default(uuid()) @db.Uuid
  sourceId            String     @unique @db.Uuid
  schedulingClass     String
  cadenceMinutes      Int?
  lastAttemptAt       DateTime?  @db.Timestamptz(3)
  lastSuccessAt       DateTime?  @db.Timestamptz(3)
  lastFailureAt       DateTime?  @db.Timestamptz(3)
  nextScheduledAt     DateTime?  @db.Timestamptz(3)
  lastRunStatus       String     @default("never")
  lastRunId           String?    @db.Uuid
  lastCreatedCount    Int        @default(0)
  lastUpdatedCount    Int        @default(0)
  consecutiveFailures Int        @default(0)
  lastErrorMessage    String?
  activeRunId         String?    @unique @db.Uuid
  lockAcquiredAt      DateTime?  @db.Timestamptz(3)
  lockExpiresAt       DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  source              DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([nextScheduledAt])
  @@index([lastRunStatus])
  @@index([lockExpiresAt])
}

model LPAPerformanceMarketYear {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceId              String     @db.Uuid
  year                  Int
  category              String
  categoryLabel         String
  geographyScope        String     @default("NATIONAL")
  revenueAud            Decimal?   @db.Decimal(18, 0)
  attendance            Int?
  averageTicketPriceAud Decimal?   @db.Decimal(12, 2)
  sourceReportTitle     String
  sourceReportUrl       String
  sourceBundleUrl       String
  sourcePublishedAt     DateTime?  @db.Timestamptz(3)
  retrievedAt           DateTime   @db.Timestamptz(3)
  firstSeenAt           DateTime   @db.Timestamptz(3)
  lastSeenAt            DateTime   @db.Timestamptz(3)
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  source                DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year, category, geographyScope])
  @@index([year])
  @@index([category, year])
  @@index([sourceId, year])
}

model BEAACPSASoundRecordingYear {
  id                           String     @id @default(uuid()) @db.Uuid
  sourceId                     String     @db.Uuid
  year                         Int
  categoryLabel                String
  acpsaOutputUsd               Decimal?   @db.Decimal(20, 0)
  acpsaValueAddedUsd           Decimal?   @db.Decimal(20, 0)
  acpsaEmployment              Int?
  acpsaEmployeeCompensationUsd Decimal?   @db.Decimal(20, 0)
  sourceArchiveUrl             String
  sourceWorkbook               String
  sourceTables                 String[]
  unitMetadata                 Json       @default("{}")
  retrievedAt                  DateTime   @db.Timestamptz(3)
  firstSeenAt                  DateTime   @db.Timestamptz(3)
  lastSeenAt                   DateTime   @db.Timestamptz(3)
  metadata                     Json       @default("{}")
  createdAt                    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime   @updatedAt @db.Timestamptz(3)
  source                       DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year])
  @@index([year])
  @@index([sourceId, year])
}

model CensusRecordIndustryYear {
  id                     String     @id @default(uuid()) @db.Uuid
  sourceId               String     @db.Uuid
  year                   Int
  naicsCode              String     @db.VarChar(6)
  industryLabel          String
  revenueUsd             Decimal?   @db.Decimal(20, 0)
  payrollUsd             Decimal?   @db.Decimal(20, 0)
  employment             Int?
  operatingExpensesUsd   Decimal?   @db.Decimal(20, 0)
  revenueFlag            String?
  payrollFlag            String?
  employmentFlag         String?
  operatingExpensesFlag  String?
  revenueCvPct           Decimal?   @db.Decimal(7, 2)
  payrollCvPct           Decimal?   @db.Decimal(7, 2)
  employmentCvPct        Decimal?   @db.Decimal(7, 2)
  operatingExpensesCvPct Decimal?   @db.Decimal(7, 2)
  sourceTable            String
  sourceVintage          String
  retrievedAt            DateTime   @db.Timestamptz(3)
  firstSeenAt            DateTime   @db.Timestamptz(3)
  lastSeenAt             DateTime   @db.Timestamptz(3)
  metadata               Json       @default("{}")
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)
  source                 DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year, naicsCode, sourceVintage])
  @@index([year])
  @@index([sourceId, year])
  @@index([naicsCode])
}

model MVTGrassrootsMusicYear {
  id                         String     @id @default(uuid()) @db.Uuid
  sourceId                   String     @db.Uuid
  year                       Int
  venueCount                 Int?
  permanentClosures          Int?
  venuesNoLongerOperating    Int?
  venuesUnprofitablePct      Decimal?   @db.Decimal(7, 2)
  averageProfitMarginPct     Decimal?   @db.Decimal(7, 2)
  eventCount                 Int?
  ticketedLiveMusicEvents    Int?
  audienceVisits             Int?
  totalSectorRevenueGbp      Decimal?   @db.Decimal(18, 0)
  liveMusicIncomeGbp         Decimal?   @db.Decimal(18, 0)
  employment                 Int?
  jobsLost                   Int?
  townsWithoutRegularTouring Int?
  sourceReportUrl            String
  sourceReleaseUrl           String
  sourcePublishedAt          DateTime?  @db.Timestamptz(3)
  retrievedAt                DateTime   @db.Timestamptz(3)
  firstSeenAt                DateTime   @db.Timestamptz(3)
  lastSeenAt                 DateTime   @db.Timestamptz(3)
  metadata                   Json       @default("{}")
  createdAt                  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @db.Timestamptz(3)
  source                     DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year])
  @@index([year])
  @@index([sourceId, year])
}

model BFIWeekendBoxOffice {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceId              String     @db.Uuid
  weekendStart          DateTime   @db.Date
  weekendEnd            DateTime   @db.Date
  sourceDateLabel       String
  reportedGrossGbp      Decimal    @db.Decimal(18, 0)
  top15GrossGbp         Decimal    @db.Decimal(18, 0)
  releaseCount          Int
  topFilm               String?
  topFilmGrossGbp       Decimal?   @db.Decimal(18, 0)
  top3GrossGbp          Decimal?   @db.Decimal(18, 0)
  top5GrossGbp          Decimal?   @db.Decimal(18, 0)
  top10GrossGbp         Decimal?   @db.Decimal(18, 0)
  sourceFileUrl         String
  sourceFileName        String
  sourceFormat          String
  sourcePublishedAt     DateTime?  @db.Timestamptz(3)
  retrievedAt           DateTime   @db.Timestamptz(3)
  firstSeenAt           DateTime   @db.Timestamptz(3)
  lastSeenAt            DateTime   @db.Timestamptz(3)
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  source                DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, weekendEnd])
  @@index([weekendEnd])
  @@index([sourceId, weekendEnd])
}

model BFIFilmMarketYear {
  id                        String     @id @default(uuid()) @db.Uuid
  sourceId                  String     @db.Uuid
  year                      Int
  cinemaAdmissionsMillions Decimal?   @db.Decimal(10, 1)
  ukBoxOfficeGrossGbpM      Decimal?   @db.Decimal(12, 1)
  releaseCount              Int?
  filmProductionSpendGbpM  Decimal?   @db.Decimal(12, 1)
  filmProductionCount      Int?
  hetvProductionSpendGbpM  Decimal?   @db.Decimal(12, 1)
  hetvProductionCount      Int?
  sourceBoxOfficeUrl        String?
  sourceProductionUrl       String?
  sourceYearbook            String
  retrievedAt               DateTime   @db.Timestamptz(3)
  firstSeenAt               DateTime   @db.Timestamptz(3)
  lastSeenAt                DateTime   @db.Timestamptz(3)
  metadata                  Json       @default("{}")
  createdAt                 DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @db.Timestamptz(3)
  source                    DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year])
  @@index([year])
  @@index([sourceId, year])
}

model BroadwayMarketWeek {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceId              String     @db.Uuid
  sourceWeekId          Int
  seasonWeekNumber      Int
  weekStart             DateTime   @db.Date
  weekEnding            DateTime   @db.Date
  grossUsd              Decimal    @db.Decimal(18, 2)
  attendance            Int
  showCount             Int?
  capacityPct           Decimal?   @db.Decimal(7, 2)
  averageTicketPriceUsd Decimal?   @db.Decimal(12, 2)
  performanceCount      Int?
  previewCount          Int?
  sourceUrl             String
  retrievedAt           DateTime   @db.Timestamptz(3)
  firstSeenAt           DateTime   @db.Timestamptz(3)
  lastSeenAt            DateTime   @db.Timestamptz(3)
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  source                DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, weekEnding])
  @@index([weekEnding])
  @@index([sourceId, weekEnding])
}

model USBoxOfficeWeekend {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceId              String     @db.Uuid
  sourceYear            Int
  weekNumber            Int
  weekendStart          DateTime   @db.Date
  weekendEnd            DateTime   @db.Date
  sourceDateLabel       String
  occasion              String?
  totalGrossUsd         Decimal    @db.Decimal(18, 0)
  top10GrossUsd         Decimal?   @db.Decimal(18, 0)
  overallWowChangePct   Decimal?   @db.Decimal(8, 3)
  top10WowChangePct     Decimal?   @db.Decimal(8, 3)
  overallWowChangeLabel String?
  top10WowChangeLabel   String?
  releaseCount          Int?
  topFilm               String?
  datasetSlug           String
  datasetUpdatedAt      DateTime?  @db.Timestamptz(3)
  sourceUrl             String
  retrievedAt           DateTime   @db.Timestamptz(3)
  firstSeenAt           DateTime   @db.Timestamptz(3)
  lastSeenAt            DateTime   @db.Timestamptz(3)
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  source                DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, sourceYear, weekNumber])
  @@index([weekendEnd])
  @@index([sourceId, weekendEnd])
}

model MetricDefinition {
  id           String              @id @default(uuid()) @db.Uuid
  slug         String              @unique
  name         String
  description  String
  unit         String
  frequency    String
  sourceId     String              @db.Uuid
  countryCode  String?             @db.VarChar(3)
  sectorSlug   String
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  source       DataSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  country      Country?            @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector       Sector              @relation(fields: [sectorSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  observations MetricObservation[]

  @@index([sourceId])
  @@index([countryCode, sectorSlug])
}

model MetricObservation {
  id                  String           @id @default(uuid()) @db.Uuid
  metricDefinitionId  String           @db.Uuid
  periodStart         DateTime         @db.Timestamptz(3)
  periodEnd           DateTime         @db.Timestamptz(3)
  value               Decimal          @db.Decimal(20, 6)
  previousValue       Decimal?         @db.Decimal(20, 6)
  prePandemicBaseline Decimal?         @db.Decimal(20, 6)
  sourceUrl           String?
  retrievedAt         DateTime         @db.Timestamptz(3)
  metadata            Json             @default("{}")
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  metricDefinition    MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@unique([metricDefinitionId, periodStart, periodEnd])
  @@index([periodStart])
  @@index([retrievedAt])
}

model IndustryEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventType    String
  title        String
  summary      String
  countryCode  String?  @db.VarChar(3)
  sectorSlug   String
  organisation String?
  eventDate    DateTime @db.Timestamptz(3)
  sourceUrl    String
  sourceName   String
  confidence   Decimal  @db.Decimal(3, 2)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  country      Country? @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector       Sector   @relation(fields: [sectorSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)

  @@index([eventDate])
  @@index([eventType])
  @@index([countryCode, sectorSlug])
}

model MediaArticle {
  id                      String                    @id @default(uuid()) @db.Uuid
  sourceId                String                    @db.Uuid
  sourceType              String
  externalId              String?
  canonicalUrl            String                    @unique
  title                   String
  description             String?
  publisher               String
  sourceDomain            String
  publishedAt             DateTime                  @db.Timestamptz(3)
  retrievedAt             DateTime                  @db.Timestamptz(3)
  language                String?
  countryCode             String?                   @db.VarChar(3)
  sectorSlug              String?
  eventType               String?
  polarity                String
  confidence              String
  importance              Int
  aiImpactType            String?
  reviewState             String
  classificationRationale String
  storyFingerprint        String?
  possibleDuplicateStory  Boolean                   @default(false)
  firstSeenAt             DateTime                  @db.Timestamptz(3)
  lastSeenAt              DateTime                  @db.Timestamptz(3)
  metadata                Json                      @default("{}")
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  source                  DataSource                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  country                 Country?                  @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector                  Sector?                   @relation(fields: [sectorSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  sourceMatches           MediaArticleSourceMatch[]

  @@index([publishedAt])
  @@index([sectorSlug, publishedAt])
  @@index([eventType, publishedAt])
  @@index([polarity, importance, publishedAt])
  @@index([aiImpactType, publishedAt])
  @@index([countryCode, publishedAt])
  @@index([storyFingerprint, publishedAt])
  @@index([sourceId])
}

model MediaArticleSourceMatch {
  id             String       @id @default(uuid()) @db.Uuid
  matchKey       String       @unique
  mediaArticleId String       @db.Uuid
  sourceId       String       @db.Uuid
  sourceType     String
  externalId     String?
  queryFamily    String?
  feedSlug       String?
  firstSeenAt    DateTime     @db.Timestamptz(3)
  lastSeenAt     DateTime     @db.Timestamptz(3)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  mediaArticle   MediaArticle @relation(fields: [mediaArticleId], references: [id], onDelete: Cascade)
  source         DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([mediaArticleId])
  @@index([sourceId, sourceType])
  @@index([feedSlug])
  @@index([queryFamily])
}

model TicketmasterVenue {
  id             String              @id @default(uuid()) @db.Uuid
  ticketmasterId String              @unique
  name           String
  city           String?
  region         String?
  countryCode    String              @db.VarChar(3)
  timezone       String?
  latitude       Decimal?            @db.Decimal(10, 7)
  longitude      Decimal?            @db.Decimal(10, 7)
  firstSeenAt    DateTime            @db.Timestamptz(3)
  lastSeenAt     DateTime            @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  country        Country             @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  events         TicketmasterEvent[]

  @@index([countryCode, city])
}

model TicketmasterEvent {
  id                  String                          @id @default(uuid()) @db.Uuid
  ticketmasterId      String                          @unique
  sourceId            String                          @db.Uuid
  venueId             String?                         @db.Uuid
  name                String
  sourceUrl           String
  sourcePlatform      String
  countryCode         String                          @db.VarChar(3)
  sectorSlug          String
  localDate           String
  localTime           String?
  eventDateTime       DateTime?                       @db.Timestamptz(3)
  timezone            String?
  status              String
  previousStatus      String?
  statusChangedAt     DateTime?                       @db.Timestamptz(3)
  segmentId           String
  segmentName         String
  genreId             String?
  genreName           String?
  subGenreId          String?
  subGenreName        String?
  promoterId          String?
  promoterName        String?
  publicOnsaleStartAt DateTime?                       @db.Timestamptz(3)
  publicOnsaleEndAt   DateTime?                       @db.Timestamptz(3)
  priceMin            Decimal?                        @db.Decimal(12, 2)
  priceMax            Decimal?                        @db.Decimal(12, 2)
  priceCurrency       String?                         @db.VarChar(3)
  priceType           String?
  locale              String?
  testEvent           Boolean                         @default(false)
  firstSeenAt         DateTime                        @db.Timestamptz(3)
  lastSeenAt          DateTime                        @db.Timestamptz(3)
  retrievedAt         DateTime                        @db.Timestamptz(3)
  metadata            Json                            @default("{}")
  createdAt           DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                        @updatedAt @db.Timestamptz(3)
  source              DataSource                      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  venue               TicketmasterVenue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  country             Country                         @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  sector              Sector                          @relation(fields: [sectorSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  statusChanges       TicketmasterEventStatusChange[]

  @@index([eventDateTime])
  @@index([countryCode, sectorSlug, eventDateTime])
  @@index([status])
  @@index([venueId])
  @@index([sourceId])
}

model TicketmasterEventStatusChange {
  id                  String            @id @default(uuid()) @db.Uuid
  ticketmasterEventId String            @db.Uuid
  ingestionRunId      String            @db.Uuid
  sourceEventId       String
  countryCode         String            @db.VarChar(3)
  segmentName         String
  previousStatus      String
  newStatus           String
  changedAt           DateTime          @db.Timestamptz(3)
  observedAt          DateTime          @db.Timestamptz(3)
  metadata            Json              @default("{}")
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  ticketmasterEvent   TicketmasterEvent @relation(fields: [ticketmasterEventId], references: [id], onDelete: Cascade)
  ingestionRun        IngestionRun      @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)

  @@unique([ticketmasterEventId, ingestionRunId])
  @@index([observedAt])
  @@index([countryCode, segmentName, observedAt])
  @@index([previousStatus, newStatus, observedAt])
  @@index([sourceEventId])
}

model TicketmasterSupplySnapshot {
  id                       String       @id @default(uuid()) @db.Uuid
  ingestionRunId           String       @db.Uuid
  capturedAt               DateTime     @db.Timestamptz(3)
  windowDays               Int
  countryCode              String       @db.VarChar(3)
  segmentName              String
  uniqueEventCount         Int
  activeVenueCount         Int
  eventsPerVenue           Decimal?     @db.Decimal(14, 6)
  onsaleCount              Int
  offsaleCount             Int
  cancelledCount           Int
  canceledCount            Int
  postponedCount           Int
  rescheduledCount         Int
  priceRangeAvailableCount Int
  priceCoveragePct         Decimal?     @db.Decimal(7, 4)
  statusCounts             Json         @default("{}")
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  ingestionRun             IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)

  @@unique([ingestionRunId, windowDays, countryCode, segmentName])
  @@index([countryCode, segmentName, windowDays, capturedAt])
  @@index([capturedAt])
}

model IngestionRun {
  id                          String                          @id @default(uuid()) @db.Uuid
  sourceId                    String                          @db.Uuid
  status                      String
  startedAt                   DateTime                        @db.Timestamptz(3)
  completedAt                 DateTime?                       @db.Timestamptz(3)
  recordsRead                 Int                             @default(0)
  recordsCreated              Int                             @default(0)
  recordsUpdated              Int                             @default(0)
  errorMessage                String?
  metadata                    Json                            @default("{}")
  createdAt                   DateTime                        @default(now()) @db.Timestamptz(3)
  source                      DataSource                      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ticketmasterStatusChanges   TicketmasterEventStatusChange[]
  ticketmasterSupplySnapshots TicketmasterSupplySnapshot[]
  steamGameSnapshots          SteamGameSnapshot[]

  @@index([sourceId, startedAt])
  @@index([status])
}

model Game {
  id                  String              @id @default(uuid()) @db.Uuid
  igdbId              Int                 @unique
  sourceId            String              @db.Uuid
  name                String
  slug                String
  firstReleaseDate    DateTime?           @db.Timestamptz(3)
  gameTypeId          Int
  gameTypeName        String
  gameStatusId        Int?
  gameStatusName      String?
  parentIgdbId        Int?
  versionParentIgdbId Int?
  steamAppId          Int?
  igdbCreatedAt       DateTime?           @db.Timestamptz(3)
  igdbUpdatedAt       DateTime?           @db.Timestamptz(3)
  firstSeenAt         DateTime            @db.Timestamptz(3)
  lastSeenAt          DateTime            @db.Timestamptz(3)
  retrievedAt         DateTime            @db.Timestamptz(3)
  metadata            Json                @default("{}")
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  source              DataSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  companies           GameCompanyRole[]
  genres              GameGenre[]
  platforms           GamePlatform[]
  releases            GameRelease[]
  externalIds         GameExternalId[]
  steamSnapshots      SteamGameSnapshot[]

  @@index([firstReleaseDate])
  @@index([gameTypeId])
  @@index([gameStatusId])
  @@index([sourceId])
  @@index([steamAppId])
}

model GameCompany {
  id          String            @id @default(uuid()) @db.Uuid
  igdbId      Int               @unique
  name        String
  firstSeenAt DateTime          @db.Timestamptz(3)
  lastSeenAt  DateTime          @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  games       GameCompanyRole[]

  @@index([name])
}

model GameCompanyRole {
  id        String      @id @default(uuid()) @db.Uuid
  gameId    String      @db.Uuid
  companyId String      @db.Uuid
  developer Boolean     @default(false)
  publisher Boolean     @default(false)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  game      Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  company   GameCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([gameId, companyId])
  @@index([companyId, developer, publisher])
}

model GameGenre {
  id          String   @id @default(uuid()) @db.Uuid
  gameId      String   @db.Uuid
  igdbGenreId Int
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, igdbGenreId])
  @@index([igdbGenreId, name])
}

model GamePlatform {
  id             String   @id @default(uuid()) @db.Uuid
  gameId         String   @db.Uuid
  igdbPlatformId Int
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, igdbPlatformId])
  @@index([igdbPlatformId, name])
}

model GameRelease {
  id                String    @id @default(uuid()) @db.Uuid
  gameId            String    @db.Uuid
  igdbReleaseDateId Int       @unique
  releaseDate       DateTime? @db.Timestamptz(3)
  dateCategory      Int?
  regionId          Int?
  platformIgdbId    Int?
  platformName      String?
  statusId          Int?
  statusName        String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  game              Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, releaseDate])
  @@index([platformIgdbId, releaseDate])
}

model GameExternalId {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @db.Uuid
  category  Int
  uid       String
  name      String?
  sourceUrl String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, category, uid])
  @@index([gameId, category])
}

model SteamGameSnapshot {
  id               String       @id @default(uuid()) @db.Uuid
  gameId           String       @db.Uuid
  sourceId         String       @db.Uuid
  ingestionRunId   String       @db.Uuid
  steamAppId       Int
  capturedAt       DateTime     @db.Timestamptz(3)
  retrievedAt      DateTime     @db.Timestamptz(3)
  storeAvailable   Boolean
  currentPlayers   Int?
  totalReviews     Int?
  positiveReviews  Int?
  positivePercent  Decimal?     @db.Decimal(7, 4)
  reviewScore      Int?
  reviewScoreLabel String?
  currentPrice     Int?
  originalPrice    Int?
  discountPercent  Int?
  currency         String?      @db.VarChar(3)
  freeToPlay       Boolean?
  storeReleaseDate String?
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  game             Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  source           DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun     IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)

  @@unique([gameId, capturedAt])
  @@index([capturedAt])
  @@index([steamAppId, capturedAt])
  @@index([sourceId])
  @@index([ingestionRunId])
}
