generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaClassificationFeedbackReason {
  WRONG_SECTOR
  WRONG_EVENT_TYPE
  WRONG_AI_TAG
  WRONG_SIGNAL_DIRECTION
  WRONG_IMPORTANCE
  NOT_RELEVANT_TO_CULTURAL_INTELLIGENCE
}

enum MediaClassificationReviewState {
  CORRECT
  WRONG_CLASSIFICATION
}

enum MediaClassificationReviewAction {
  CORRECT
  WRONG_CLASSIFICATION
  CLEAR
}

enum MediaClassificationDimensionReviewStatus {
  UNREVIEWED
  APPROVED
  CORRECTED
  REJECTED
}

enum ResearchRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ResearchTraceConfidence {
  TRACE_OPENED
  TRACE_ATTEMPTED
  MODEL_REPORTED_ONLY
}

enum ResearchEvidenceMediation {
  DIRECTLY_OPENED
  SEARCH_MEDIATED
  MODEL_REPORTED
}

enum ResearchCandidateValidationState {
  UNVERIFIED
  VALIDATED
  QUARANTINED
}

enum ResearchCandidateReviewDecision {
  APPROVED_FOR_INGESTION_INVESTIGATION
  REJECTED
  ALREADY_COVERED
  NOT_USEFUL
  SUPERSEDED
}

enum ScreenAustraliaBoxOfficePeriodType {
  WEEKLY_TOP_5
  AUSTRALIAN_YTD
  MONTHLY_TOP_20
  OVERALL_YTD_TOP_50
}

model Country {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(3)
  name               String              @unique
  region             String
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  dataSources        DataSource[]
  metricDefinitions  MetricDefinition[]
  industryEvents     IndustryEvent[]
  mediaArticles      MediaArticle[]
  ticketmasterEvents TicketmasterEvent[]
  ticketmasterVenues TicketmasterVenue[]
}

model Sector {
  id                 String              @id @default(uuid()) @db.Uuid
  slug               String              @unique
  name               String              @unique
  description        String
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  dataSources        DataSource[]
  metricDefinitions  MetricDefinition[]
  industryEvents     IndustryEvent[]
  mediaArticles      MediaArticle[]
  ticketmasterEvents TicketmasterEvent[]
}

model DataSource {
  id                                   String                                @id @default(uuid()) @db.Uuid
  slug                                 String                                @unique
  name                                 String
  provider                             String
  baseUrl                              String
  countryCode                          String?                               @db.VarChar(3)
  sectorSlug                           String?
  requiresAuthentication               Boolean                               @default(false)
  enabled                              Boolean                               @default(false)
  lastSuccessfulSyncAt                 DateTime?                             @db.Timestamptz(3)
  lastAttemptedSyncAt                  DateTime?                             @db.Timestamptz(3)
  createdAt                            DateTime                              @default(now()) @db.Timestamptz(3)
  updatedAt                            DateTime                              @updatedAt @db.Timestamptz(3)
  country                              Country?                              @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector                               Sector?                               @relation(fields: [sectorSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  metricDefinitions                    MetricDefinition[]
  ingestionRuns                        IngestionRun[]
  ticketmasterEvents                   TicketmasterEvent[]
  games                                Game[]
  steamGameSnapshots                   SteamGameSnapshot[]
  mediaArticles                        MediaArticle[]
  mediaArticleMatches                  MediaArticleSourceMatch[]
  usBoxOfficeWeekends                  USBoxOfficeWeekend[]
  broadwayMarketWeeks                  BroadwayMarketWeek[]
  lpaPerformanceYears                  LPAPerformanceMarketYear[]
  bfiWeekendBoxOffice                  BFIWeekendBoxOffice[]
  bfiFilmMarketYears                   BFIFilmMarketYear[]
  screenAustraliaBoxOfficeObservations ScreenAustraliaBoxOfficeObservation[]
  mvtGrassrootsYears                   MVTGrassrootsMusicYear[]
  censusRecordYears                    CensusRecordIndustryYear[]
  beaAcpsaSoundYears                   BEAACPSASoundRecordingYear[]
  schedulerState                       SchedulerSourceState?
  lunaStorySyntheses                   LunaStorySynthesis[]

  @@index([countryCode])
  @@index([sectorSlug])
  @@index([enabled])
}

model SchedulerSourceState {
  id                  String     @id @default(uuid()) @db.Uuid
  sourceId            String     @unique @db.Uuid
  schedulingClass     String
  cadenceMinutes      Int?
  lastAttemptAt       DateTime?  @db.Timestamptz(3)
  lastSuccessAt       DateTime?  @db.Timestamptz(3)
  lastFailureAt       DateTime?  @db.Timestamptz(3)
  nextScheduledAt     DateTime?  @db.Timestamptz(3)
  lastRunStatus       String     @default("never")
  lastRunId           String?    @db.Uuid
  lastCreatedCount    Int        @default(0)
  lastUpdatedCount    Int        @default(0)
  consecutiveFailures Int        @default(0)
  lastErrorMessage    String?
  activeRunId         String?    @unique @db.Uuid
  lockAcquiredAt      DateTime?  @db.Timestamptz(3)
  lockExpiresAt       DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  source              DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([nextScheduledAt])
  @@index([lastRunStatus])
  @@index([lockExpiresAt])
}

model LPAPerformanceMarketYear {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceId              String     @db.Uuid
  year                  Int
  category              String
  categoryLabel         String
  geographyScope        String     @default("NATIONAL")
  revenueAud            Decimal?   @db.Decimal(18, 0)
  attendance            Int?
  averageTicketPriceAud Decimal?   @db.Decimal(12, 2)
  sourceReportTitle     String
  sourceReportUrl       String
  sourceBundleUrl       String
  sourcePublishedAt     DateTime?  @db.Timestamptz(3)
  retrievedAt           DateTime   @db.Timestamptz(3)
  firstSeenAt           DateTime   @db.Timestamptz(3)
  lastSeenAt            DateTime   @db.Timestamptz(3)
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  source                DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year, category, geographyScope])
  @@index([year])
  @@index([category, year])
  @@index([sourceId, year])
}

model BEAACPSASoundRecordingYear {
  id                           String     @id @default(uuid()) @db.Uuid
  sourceId                     String     @db.Uuid
  year                         Int
  categoryLabel                String
  acpsaOutputUsd               Decimal?   @db.Decimal(20, 0)
  acpsaValueAddedUsd           Decimal?   @db.Decimal(20, 0)
  acpsaEmployment              Int?
  acpsaEmployeeCompensationUsd Decimal?   @db.Decimal(20, 0)
  sourceArchiveUrl             String
  sourceWorkbook               String
  sourceTables                 String[]
  unitMetadata                 Json       @default("{}")
  retrievedAt                  DateTime   @db.Timestamptz(3)
  firstSeenAt                  DateTime   @db.Timestamptz(3)
  lastSeenAt                   DateTime   @db.Timestamptz(3)
  metadata                     Json       @default("{}")
  createdAt                    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime   @updatedAt @db.Timestamptz(3)
  source                       DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year])
  @@index([year])
  @@index([sourceId, year])
}

model CensusRecordIndustryYear {
  id                     String     @id @default(uuid()) @db.Uuid
  sourceId               String     @db.Uuid
  year                   Int
  naicsCode              String     @db.VarChar(6)
  industryLabel          String
  revenueUsd             Decimal?   @db.Decimal(20, 0)
  payrollUsd             Decimal?   @db.Decimal(20, 0)
  employment             Int?
  operatingExpensesUsd   Decimal?   @db.Decimal(20, 0)
  revenueFlag            String?
  payrollFlag            String?
  employmentFlag         String?
  operatingExpensesFlag  String?
  revenueCvPct           Decimal?   @db.Decimal(7, 2)
  payrollCvPct           Decimal?   @db.Decimal(7, 2)
  employmentCvPct        Decimal?   @db.Decimal(7, 2)
  operatingExpensesCvPct Decimal?   @db.Decimal(7, 2)
  sourceTable            String
  sourceVintage          String
  retrievedAt            DateTime   @db.Timestamptz(3)
  firstSeenAt            DateTime   @db.Timestamptz(3)
  lastSeenAt             DateTime   @db.Timestamptz(3)
  metadata               Json       @default("{}")
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)
  source                 DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year, naicsCode, sourceVintage])
  @@index([year])
  @@index([sourceId, year])
  @@index([naicsCode])
}

model MVTGrassrootsMusicYear {
  id                         String     @id @default(uuid()) @db.Uuid
  sourceId                   String     @db.Uuid
  year                       Int
  venueCount                 Int?
  permanentClosures          Int?
  venuesNoLongerOperating    Int?
  venuesUnprofitablePct      Decimal?   @db.Decimal(7, 2)
  averageProfitMarginPct     Decimal?   @db.Decimal(7, 2)
  eventCount                 Int?
  ticketedLiveMusicEvents    Int?
  audienceVisits             Int?
  totalSectorRevenueGbp      Decimal?   @db.Decimal(18, 0)
  liveMusicIncomeGbp         Decimal?   @db.Decimal(18, 0)
  employment                 Int?
  jobsLost                   Int?
  townsWithoutRegularTouring Int?
  sourceReportUrl            String
  sourceReleaseUrl           String
  sourcePublishedAt          DateTime?  @db.Timestamptz(3)
  retrievedAt                DateTime   @db.Timestamptz(3)
  firstSeenAt                DateTime   @db.Timestamptz(3)
  lastSeenAt                 DateTime   @db.Timestamptz(3)
  metadata                   Json       @default("{}")
  createdAt                  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @db.Timestamptz(3)
  source                     DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year])
  @@index([year])
  @@index([sourceId, year])
}

model BFIWeekendBoxOffice {
  id                String     @id @default(uuid()) @db.Uuid
  sourceId          String     @db.Uuid
  weekendStart      DateTime   @db.Date
  weekendEnd        DateTime   @db.Date
  sourceDateLabel   String
  reportedGrossGbp  Decimal    @db.Decimal(18, 0)
  top15GrossGbp     Decimal    @db.Decimal(18, 0)
  releaseCount      Int
  topFilm           String?
  topFilmGrossGbp   Decimal?   @db.Decimal(18, 0)
  top3GrossGbp      Decimal?   @db.Decimal(18, 0)
  top5GrossGbp      Decimal?   @db.Decimal(18, 0)
  top10GrossGbp     Decimal?   @db.Decimal(18, 0)
  sourceFileUrl     String
  sourceFileName    String
  sourceFormat      String
  sourcePublishedAt DateTime?  @db.Timestamptz(3)
  retrievedAt       DateTime   @db.Timestamptz(3)
  firstSeenAt       DateTime   @db.Timestamptz(3)
  lastSeenAt        DateTime   @db.Timestamptz(3)
  metadata          Json       @default("{}")
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)
  source            DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, weekendEnd])
  @@index([weekendEnd])
  @@index([sourceId, weekendEnd])
}

model BFIFilmMarketYear {
  id                       String     @id @default(uuid()) @db.Uuid
  sourceId                 String     @db.Uuid
  year                     Int
  cinemaAdmissionsMillions Decimal?   @db.Decimal(10, 1)
  ukBoxOfficeGrossGbpM     Decimal?   @db.Decimal(12, 1)
  releaseCount             Int?
  filmProductionSpendGbpM  Decimal?   @db.Decimal(12, 1)
  filmProductionCount      Int?
  hetvProductionSpendGbpM  Decimal?   @db.Decimal(12, 1)
  hetvProductionCount      Int?
  sourceBoxOfficeUrl       String?
  sourceProductionUrl      String?
  sourceYearbook           String
  retrievedAt              DateTime   @db.Timestamptz(3)
  firstSeenAt              DateTime   @db.Timestamptz(3)
  lastSeenAt               DateTime   @db.Timestamptz(3)
  metadata                 Json       @default("{}")
  createdAt                DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @db.Timestamptz(3)
  source                   DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, year])
  @@index([year])
  @@index([sourceId, year])
}

model BroadwayMarketWeek {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceId              String     @db.Uuid
  sourceWeekId          Int
  seasonWeekNumber      Int
  weekStart             DateTime   @db.Date
  weekEnding            DateTime   @db.Date
  grossUsd              Decimal    @db.Decimal(18, 2)
  attendance            Int
  showCount             Int?
  capacityPct           Decimal?   @db.Decimal(7, 2)
  averageTicketPriceUsd Decimal?   @db.Decimal(12, 2)
  performanceCount      Int?
  previewCount          Int?
  sourceUrl             String
  retrievedAt           DateTime   @db.Timestamptz(3)
  firstSeenAt           DateTime   @db.Timestamptz(3)
  lastSeenAt            DateTime   @db.Timestamptz(3)
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  source                DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, weekEnding])
  @@index([weekEnding])
  @@index([sourceId, weekEnding])
}

model USBoxOfficeWeekend {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceId              String     @db.Uuid
  sourceYear            Int
  weekNumber            Int
  weekendStart          DateTime   @db.Date
  weekendEnd            DateTime   @db.Date
  sourceDateLabel       String
  occasion              String?
  totalGrossUsd         Decimal    @db.Decimal(18, 0)
  top10GrossUsd         Decimal?   @db.Decimal(18, 0)
  overallWowChangePct   Decimal?   @db.Decimal(8, 3)
  top10WowChangePct     Decimal?   @db.Decimal(8, 3)
  overallWowChangeLabel String?
  top10WowChangeLabel   String?
  releaseCount          Int?
  topFilm               String?
  datasetSlug           String
  datasetUpdatedAt      DateTime?  @db.Timestamptz(3)
  sourceUrl             String
  retrievedAt           DateTime   @db.Timestamptz(3)
  firstSeenAt           DateTime   @db.Timestamptz(3)
  lastSeenAt            DateTime   @db.Timestamptz(3)
  metadata              Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  source                DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, sourceYear, weekNumber])
  @@index([weekendEnd])
  @@index([sourceId, weekendEnd])
}

model MetricDefinition {
  id           String              @id @default(uuid()) @db.Uuid
  slug         String              @unique
  name         String
  description  String
  unit         String
  frequency    String
  sourceId     String              @db.Uuid
  countryCode  String?             @db.VarChar(3)
  sectorSlug   String
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  source       DataSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  country      Country?            @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector       Sector              @relation(fields: [sectorSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  observations MetricObservation[]

  @@index([sourceId])
  @@index([countryCode, sectorSlug])
}

model MetricObservation {
  id                  String           @id @default(uuid()) @db.Uuid
  metricDefinitionId  String           @db.Uuid
  periodStart         DateTime         @db.Timestamptz(3)
  periodEnd           DateTime         @db.Timestamptz(3)
  value               Decimal          @db.Decimal(20, 6)
  previousValue       Decimal?         @db.Decimal(20, 6)
  prePandemicBaseline Decimal?         @db.Decimal(20, 6)
  sourceUrl           String?
  retrievedAt         DateTime         @db.Timestamptz(3)
  metadata            Json             @default("{}")
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  metricDefinition    MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@unique([metricDefinitionId, periodStart, periodEnd])
  @@index([periodStart])
  @@index([retrievedAt])
}

model IndustryEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventType    String
  title        String
  summary      String
  countryCode  String?  @db.VarChar(3)
  sectorSlug   String
  organisation String?
  eventDate    DateTime @db.Timestamptz(3)
  sourceUrl    String
  sourceName   String
  confidence   Decimal  @db.Decimal(3, 2)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  country      Country? @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector       Sector   @relation(fields: [sectorSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)

  @@index([eventDate])
  @@index([eventType])
  @@index([countryCode, sectorSlug])
}

model MediaArticle {
  id                         String                           @id @default(uuid()) @db.Uuid
  sourceId                   String                           @db.Uuid
  sourceType                 String
  externalId                 String?
  canonicalUrl               String                           @unique
  title                      String
  description                String?
  publisher                  String
  sourceDomain               String
  publishedAt                DateTime                         @db.Timestamptz(3)
  retrievedAt                DateTime                         @db.Timestamptz(3)
  language                   String?
  countryCode                String?                          @db.VarChar(3)
  sectorSlug                 String?
  eventType                  String?
  polarity                   String
  confidence                 String
  importance                 Int
  aiImpactType               String?
  reviewState                String
  classificationRationale    String
  storyFingerprint           String?
  possibleDuplicateStory     Boolean                          @default(false)
  firstSeenAt                DateTime                         @db.Timestamptz(3)
  lastSeenAt                 DateTime                         @db.Timestamptz(3)
  metadata                   Json                             @default("{}")
  createdAt                  DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                         @updatedAt @db.Timestamptz(3)
  source                     DataSource                       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  country                    Country?                         @relation(fields: [countryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  sector                     Sector?                          @relation(fields: [sectorSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  sourceMatches              MediaArticleSourceMatch[]
  classificationFeedback     MediaClassificationFeedback?
  classificationReviewEvents MediaClassificationReviewEvent[]

  @@index([publishedAt])
  @@index([sectorSlug, publishedAt])
  @@index([eventType, publishedAt])
  @@index([polarity, importance, publishedAt])
  @@index([aiImpactType, publishedAt])
  @@index([countryCode, publishedAt])
  @@index([storyFingerprint, publishedAt])
  @@index([sourceId])
}

model MediaClassificationFeedback {
  id                       String                              @id @default(uuid()) @db.Uuid
  mediaArticleId           String                              @unique @db.Uuid
  reviewState              MediaClassificationReviewState
  reasons                  MediaClassificationFeedbackReason[]
  correctedSector          String?
  correctedEventType       String?
  correctedEventTypeToNull Boolean                             @default(false)
  correctedAiTag           String?
  correctedSignalDirection String?
  correctedImportance      Int?
  approvedSector           String?
  approvedEventType        String?
  approvedAiTag            String?
  approvedSignalDirection  String?
  approvedImportance       Int?
  approvedConfidence       String?
  reviewedAt               DateTime                            @db.Timestamptz(3)
  createdAt                DateTime                            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                            @updatedAt @db.Timestamptz(3)
  mediaArticle             MediaArticle                        @relation(fields: [mediaArticleId], references: [id], onDelete: Cascade)

  @@index([reviewedAt])
  @@index([reviewState, reviewedAt])
}

model MediaClassificationReviewEvent {
  id                          String                                   @id @default(uuid()) @db.Uuid
  mediaArticleId              String                                   @db.Uuid
  supersedesReviewEventId     String?                                  @unique @db.Uuid
  action                      MediaClassificationReviewAction
  reasons                     MediaClassificationFeedbackReason[]
  canonicalUrl                String
  contentHash                 String                                   @db.Char(64)
  storyFingerprint            String?
  publishedAt                 DateTime                                 @db.Timestamptz(3)
  inputSnapshot               Json
  machinePrediction           Json
  predictedAt                 DateTime                                 @db.Timestamptz(3)
  classifierVersion           String
  rulesetVersion              String
  taxonomyVersion             String
  signalDirectionVersion      String
  inputSchemaVersion          String
  reviewGuidelineVersion      String
  codeRevision                String?
  sectorReviewStatus          MediaClassificationDimensionReviewStatus
  humanSector                 String?
  eventTypeReviewStatus       MediaClassificationDimensionReviewStatus
  humanEventType              String?
  signalDirectionReviewStatus MediaClassificationDimensionReviewStatus
  humanSignalDirection        String?
  importanceReviewStatus      MediaClassificationDimensionReviewStatus
  humanImportance             Int?
  confidenceReviewStatus      MediaClassificationDimensionReviewStatus
  humanConfidence             String?
  relevanceReviewStatus       MediaClassificationDimensionReviewStatus
  humanRelevant               Boolean?
  legacyAiReviewStatus        MediaClassificationDimensionReviewStatus
  humanLegacyAiImpactType     String?
  reviewedAt                  DateTime                                 @db.Timestamptz(3)
  createdAt                   DateTime                                 @default(now()) @db.Timestamptz(3)
  mediaArticle                MediaArticle                             @relation(fields: [mediaArticleId], references: [id], onDelete: Restrict)
  supersedesReviewEvent       MediaClassificationReviewEvent?          @relation("MediaClassificationReviewSupersession", fields: [supersedesReviewEventId], references: [id], onDelete: Restrict)
  supersededByReviewEvent     MediaClassificationReviewEvent?          @relation("MediaClassificationReviewSupersession")

  @@index([mediaArticleId, createdAt])
  @@index([reviewedAt])
  @@index([classifierVersion, taxonomyVersion])
  @@index([contentHash])
}

model LunaStorySynthesis {
  id                      String                      @id @default(uuid()) @db.Uuid
  sourceId                String                      @db.Uuid
  identityKey             String                      @unique @db.Char(64)
  storyKey                String
  clusterId               String
  representativeArticleId String                      @db.Uuid
  evidenceFingerprint     String                      @db.Char(64)
  evidenceVersion         String
  promptVersion           String
  outputSchemaVersion     String
  requestedModel          String
  responseModel           String?
  status                  String
  evidenceMetadata        Json                        @default("{}")
  synthesisPayload        Json?
  inputTokens             Int?
  cachedInputTokens       Int?
  outputTokens            Int?
  totalTokens             Int?
  estimatedCostUsd        Decimal?                    @db.Decimal(12, 8)
  latencyMs               Int?
  attemptedAt             DateTime                    @db.Timestamptz(3)
  generatedAt             DateTime?                   @db.Timestamptz(3)
  nextAttemptAt           DateTime?                   @db.Timestamptz(3)
  leaseId                 String?                     @db.Uuid
  leaseExpiresAt          DateTime?                   @db.Timestamptz(3)
  failureKind             String?
  failureMessage          String?
  createdAt               DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                    @updatedAt @db.Timestamptz(3)
  source                  DataSource                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  attempts                LunaStorySynthesisAttempt[]

  @@index([clusterId, status, generatedAt])
  @@index([storyKey, status, generatedAt])
  @@index([status, nextAttemptAt])
  @@index([attemptedAt])
  @@index([sourceId, attemptedAt])
}

model LunaStorySynthesisAttempt {
  id                String             @id @default(uuid()) @db.Uuid
  synthesisId       String             @db.Uuid
  leaseId           String             @unique @db.Uuid
  status            String
  responseModel     String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  totalTokens       Int?
  estimatedCostUsd  Decimal?           @db.Decimal(12, 8)
  latencyMs         Int?
  failureKind       String?
  failureMessage    String?
  attemptedAt       DateTime           @db.Timestamptz(3)
  completedAt       DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  synthesis         LunaStorySynthesis @relation(fields: [synthesisId], references: [id], onDelete: Cascade)

  @@index([attemptedAt])
  @@index([synthesisId, attemptedAt])
  @@index([status, attemptedAt])
}

model ScreenAustraliaBoxOfficeObservation {
