  @@index([countryCode, segmentName, windowDays, capturedAt])
  @@index([capturedAt])
}

model IngestionRun {
  id                          String                          @id @default(uuid()) @db.Uuid
  sourceId                    String                          @db.Uuid
  status                      String
  startedAt                   DateTime                        @db.Timestamptz(3)
  completedAt                 DateTime?                       @db.Timestamptz(3)
  recordsRead                 Int                             @default(0)
  recordsCreated              Int                             @default(0)
  recordsUpdated              Int                             @default(0)
  errorMessage                String?
  metadata                    Json                            @default("{}")
  createdAt                   DateTime                        @default(now()) @db.Timestamptz(3)
  source                      DataSource                      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ticketmasterStatusChanges   TicketmasterEventStatusChange[]
  ticketmasterSupplySnapshots TicketmasterSupplySnapshot[]
  steamGameSnapshots          SteamGameSnapshot[]

  @@index([sourceId, startedAt])
  @@index([status])
}

model Game {
  id                  String              @id @default(uuid()) @db.Uuid
  igdbId              Int                 @unique
  sourceId            String              @db.Uuid
  name                String
  slug                String
  firstReleaseDate    DateTime?           @db.Timestamptz(3)
  gameTypeId          Int
  gameTypeName        String
  gameStatusId        Int?
  gameStatusName      String?
  parentIgdbId        Int?
  versionParentIgdbId Int?
  steamAppId          Int?
  igdbCreatedAt       DateTime?           @db.Timestamptz(3)
  igdbUpdatedAt       DateTime?           @db.Timestamptz(3)
  firstSeenAt         DateTime            @db.Timestamptz(3)
  lastSeenAt          DateTime            @db.Timestamptz(3)
  retrievedAt         DateTime            @db.Timestamptz(3)
  metadata            Json                @default("{}")
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
