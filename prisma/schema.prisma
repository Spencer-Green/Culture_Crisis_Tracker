model ResearchRun {
  id                      String                 @id @default(uuid()) @db.Uuid
  researchTaskId          String
  researchTaskVersion     String
  providerId              String
  modelId                 String
  stage1PromptVersion     String
  stage2PromptVersion     String
  contractVersion         String
  status                  ResearchRunStatus
  startedAt               DateTime               @db.Timestamptz(3)
  completedAt             DateTime?              @db.Timestamptz(3)
  durationMs              Int?
  stage1ResponseId        String?
  stage1Status            String?
  stage1InputTokens       Int?
  stage1CachedInputTokens Int?
  stage1OutputTokens      Int?
  stage1ReasoningTokens   Int?
  stage1TotalTokens       Int?
  stage1LatencyMs         Int?
  stage2ResponseId        String?
  stage2Status            String?
  stage2InputTokens       Int?
  stage2CachedInputTokens Int?
  stage2OutputTokens      Int?
  stage2ReasoningTokens   Int?
  stage2TotalTokens       Int?
  stage2LatencyMs         Int?
  combinedTotalTokens     Int?
  combinedLatencyMs       Int?
  stage1Artifact          String?                @db.Text
  resultSummary           String?                @db.Text
  researchLimitations     Json?
  nativeSearchTrace       Json?
  responseDiagnostics     Json?
  failureKind             String?
  failureMessage          String?                @db.Text
  failureReasons          Json?
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  sourceOccurrences       ResearchRunSource[]
  candidateOccurrences    ResearchRunCandidate[]
  audits                  ResearchAuditRun[]
  evidenceChecks          ResearchEvidenceCheck[]

  @@index([researchTaskId, startedAt])
  @@index([status, startedAt])
  @@index([providerId, modelId, startedAt])
}

model ResearchSourceDocument {
  id                   String                    @id @default(uuid()) @db.Uuid
  researchTaskId       String
  researchTaskVersion  String
  sourceFingerprint    String                    @unique @db.Char(64)
  sourceUrl            String
  canonicalUrl         String
  publisher            String
  title                String
  publishedAt          DateTime?                 @db.Timestamptz(3)
  publishedAtRaw       String
  reportingPeriodStart DateTime?                 @db.Timestamptz(3)
  reportingPeriodEnd   DateTime?                 @db.Timestamptz(3)
  reportingPeriodRaw   String
  sourceRole           String
  claim                String                    @db.Text
  observation          Json
  limitations          Json
  traceConfidence      ResearchTraceConfidence
  evidenceMediation    ResearchEvidenceMediation
  firstSeenAt          DateTime                  @db.Timestamptz(3)
  lastSeenAt           DateTime                  @db.Timestamptz(3)
  occurrenceCount      Int                       @default(1)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  runOccurrences       ResearchRunSource[]
  candidates           ResearchCandidate[]

  @@index([researchTaskId, lastSeenAt])
  @@index([canonicalUrl])
  @@index([traceConfidence, lastSeenAt])
}

model ResearchRunSource {
  id                  String                    @id @default(uuid()) @db.Uuid
  runId               String                    @db.Uuid
  sourceDocumentId    String                    @db.Uuid
  sourceIndex         Int
  traceConfidence     ResearchTraceConfidence
  evidenceMediation   ResearchEvidenceMediation
  claimSnapshot       String                    @db.Text
  observationSnapshot Json
  limitationsSnapshot Json
  retrievedAt         DateTime                  @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  run                 ResearchRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceDocument      ResearchSourceDocument    @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([runId, sourceIndex])
  @@index([sourceDocumentId, createdAt])
}

model ResearchCandidate {
  id                   String                           @id @default(uuid()) @db.Uuid
  sourceDocumentId     String                           @db.Uuid
  researchTaskId       String
  researchTaskVersion  String
  candidateFingerprint String                           @unique @db.Char(64)
  candidateType        String
  geography            String
  sector               String
  reportingPeriodStart DateTime?                        @db.Timestamptz(3)
  reportingPeriodEnd   DateTime?                        @db.Timestamptz(3)
  claim                String                           @db.Text
  observations         Json
  sourceRole           String
  limitations          Json
  authority            String
  freshness            String
  ingestionFeasibility String
  confidence           String
  traceConfidence      ResearchTraceConfidence
  validationState      ResearchCandidateValidationState @default(VALIDATED)
  firstSeenAt          DateTime                         @db.Timestamptz(3)
  lastSeenAt           DateTime                         @db.Timestamptz(3)
  occurrenceCount      Int                              @default(1)
  createdAt            DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                         @updatedAt @db.Timestamptz(3)
  sourceDocument       ResearchSourceDocument           @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  runOccurrences       ResearchRunCandidate[]
  reviewEvents         ResearchCandidateReviewEvent[]

  @@index([researchTaskId, lastSeenAt])
  @@index([sourceDocumentId])
  @@index([validationState, lastSeenAt])
}

model ResearchRunCandidate {
  id             String            @id @default(uuid()) @db.Uuid
  runId          String            @db.Uuid
  candidateId    String            @db.Uuid
  candidateIndex Int
  observedAt     DateTime          @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  run            ResearchRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidate      ResearchCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@unique([runId, candidateIndex])
  @@index([candidateId, createdAt])
}

model ResearchCandidateReviewEvent {
  id                      String                          @id @default(uuid()) @db.Uuid
  candidateId             String                          @db.Uuid
  supersedesReviewEventId String?                         @unique @db.Uuid
  decision                ResearchCandidateReviewDecision
  reason                  String                          @db.Text
  candidateFingerprint    String                          @db.Char(64)
  candidateSnapshot       Json
  reviewerId              String?
  reviewedAt              DateTime                        @db.Timestamptz(3)
  createdAt               DateTime                        @default(now()) @db.Timestamptz(3)
  candidate               ResearchCandidate               @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  supersedesReviewEvent   ResearchCandidateReviewEvent?   @relation("ResearchCandidateReviewSupersession", fields: [supersedesReviewEventId], references: [id], onDelete: Restrict)
  supersededByReviewEvent ResearchCandidateReviewEvent?   @relation("ResearchCandidateReviewSupersession")

  @@index([candidateId, reviewedAt])
  @@index([decision, reviewedAt])
}

// A model audit is advisory. It has no relation to canonical metrics or review decisions.
model ResearchAuditRun {
  id                String   @id @default(uuid()) @db.Uuid
  researchRunId     String?  @db.Uuid
  researchRun       ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
  promptVersion     String
  modelId           String
  inputHash         String   @db.Char(64)
  status            String
  fixtureName       String?
  cachedAuditId     String?  @db.Uuid
  inputSnapshot     Json
  result            Json?
  providerDiagnostic Json?
  providerRequestId String?
  usage             Json?
  failureMessage    String?  @db.Text
  startedAt         DateTime @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  latencyMs         Int?
  @@unique([researchRunId, promptVersion])
  @@index([inputHash, status])
  @@index([startedAt, status])
}

model ResearchEvidenceCheck {
  id String @id @default(uuid()) @db.Uuid
  researchRunId String @db.Uuid
  researchRun ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
  contractVersion String
  inputHash String @db.Char(64)
  inputSnapshot Json
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([researchRunId, contractVersion])
}
