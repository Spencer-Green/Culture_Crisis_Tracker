model TicketmasterEvent {
  id                  String                          @id @default(uuid()) @db.Uuid
  ticketmasterId      String                          @unique
  sourceId            String                          @db.Uuid
  venueId             String?                         @db.Uuid
  name                String
  sourceUrl           String
  sourcePlatform      String
  countryCode         String                          @db.VarChar(3)
  sectorSlug          String
  localDate           String
  localTime           String?
  eventDateTime       DateTime?                       @db.Timestamptz(3)
  timezone            String?
  status              String
  previousStatus      String?
  statusChangedAt     DateTime?                       @db.Timestamptz(3)
  segmentId           String
  segmentName         String
  genreId             String?
  genreName           String?
  subGenreId          String?
  subGenreName        String?
  promoterId          String?
  promoterName        String?
  publicOnsaleStartAt DateTime?                       @db.Timestamptz(3)
  publicOnsaleEndAt   DateTime?                       @db.Timestamptz(3)
  priceMin            Decimal?                        @db.Decimal(12, 2)
  priceMax            Decimal?                        @db.Decimal(12, 2)
  priceCurrency       String?                         @db.VarChar(3)
  priceType           String?
  locale              String?
  testEvent           Boolean                         @default(false)
  firstSeenAt         DateTime                        @db.Timestamptz(3)
  lastSeenAt          DateTime                        @db.Timestamptz(3)
  retrievedAt         DateTime                        @db.Timestamptz(3)
  metadata            Json                            @default("{}")
  createdAt           DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                        @updatedAt @db.Timestamptz(3)
